# Supabase browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional Web Push: generate your own VAPID pair; never commit the private key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:together@example.com

# Voice calls v2.8 — server-only TURN configuration (never NEXT_PUBLIC_)
# Comma-separated turn:/turns: URLs supplied by your TURN provider.
TURN_URLS=
# Recommended: coturn REST shared secret creates temporary per-user credentials.
TURN_SHARED_SECRET=
# Alternative: provider-issued credentials; leave shared secret empty.
TURN_USERNAME=
TURN_CREDENTIAL=
# Relay-only protects peer network addresses; see README.md.
CALLS_RELAY_ONLY=true
